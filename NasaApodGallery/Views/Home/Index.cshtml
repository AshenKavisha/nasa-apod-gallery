@model List<NasaApodGallery.Models.ApodModel>

<h1>NASA APOD Test  </h1>
@foreach (var apod in Model)
{
    <div>
        <h3>@apod.Title (@apod.ApodDate.ToString("yyyy-MM-dd"))</h3>
        @if (apod.MediaType == "image")
        {
            <img src="@apod.Url" width="300"   />
        }
        else 
        {
            <p><a href="@apod.Url" target="_blank">Watch Video</a></p>
        }
    </div>
}