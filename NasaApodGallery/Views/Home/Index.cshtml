@model List<NasaApodGallery.Models.ApodModel>

<div class="text-center mb-4">
    <h1 class="display-5">🌌 NASA APOD Gallery</h1>
    <p class="text-muted">A daily collection of astronomy pictures, fetched and saved from NASA's API.</p>
</div>

<div class="row g-4">
    @foreach (var apod in Model)
    {
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm">
                @if (apod.MediaType == "image")
                {
                    <img src="@apod.Url" class="card-img-top" alt="@apod.Title"
                         style="height: 200px; object-fit: cover;"
                         onerror="this.onerror=null; this.src='/images/placeholder.png';" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center bg-dark text-white" style="height: 200px;">
                        <a href="@apod.Url" target="_blank" class="text-white text-decoration-none">
                            ▶ Watch Video
                        </a>
                    </div>
                }
                <div class="card-body">
                    <h6 class="card-title">@apod.Title</h6>
                    <p class="card-subtitle text-muted small">@apod.ApodDate.ToString("MMM dd, yyyy")</p>
                </div>
            </div>
        </div>
    }
</div>
